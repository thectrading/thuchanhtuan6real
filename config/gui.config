<?xml version="1.0"?>
<plugin filename="GzScene3D" name="3D View">
  <ignition-gui><title>3D View</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></ignition-gui>
  <engine>ogre2</engine><scene>scene</scene><camera_pose>1.0 -1.8 1.7 0 0.623 1.805</camera_pose>
</plugin>
<plugin filename="WorldControl" name="World control">
  <ignition-gui><title>World control</title><property type="string" key="state">floating</property><anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors></ignition-gui>
  <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
</plugin>
<plugin filename="WorldStats" name="World stats">
  <ignition-gui><title>World stats</title><property type="string" key="state">floating</property><anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors></ignition-gui>
  <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor>
</plugin>
