<?xml version="1.0"?>
<sdf version="1.8">
  <world name="gesture_arena">
    <physics name="physics" type="ignored"><max_step_size>0.003</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <!-- The official Create 3 description loads Sensors. A second Sensors system
         here would create competing rendering threads on some Ogre 2 drivers. -->
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.75 0.82 0.88 1</background><shadows>false</shadows></scene>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.4 0.2 -1</direction></light>
    <model name="floor"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry><material><ambient>0.75 0.78 0.78 1</ambient><diffuse>0.75 0.78 0.78 1</diffuse></material></visual>
    </link></model>
    <model name="north_wall"><static>true</static><pose>0 4 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>8.2 0.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>8.2 0.1 1</size></box></geometry><material><ambient>0.18 0.30 0.40 1</ambient><diffuse>0.18 0.30 0.40 1</diffuse></material></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -4 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>8.2 0.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>8.2 0.1 1</size></box></geometry><material><ambient>0.18 0.30 0.40 1</ambient><diffuse>0.18 0.30 0.40 1</diffuse></material></visual></link></model>
    <model name="east_wall"><static>true</static><pose>4 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.1 8 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 8 1</size></box></geometry><material><ambient>0.18 0.30 0.40 1</ambient><diffuse>0.18 0.30 0.40 1</diffuse></material></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-4 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.1 8 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 8 1</size></box></geometry><material><ambient>0.18 0.30 0.40 1</ambient><diffuse>0.18 0.30 0.40 1</diffuse></material></visual></link></model>
    <!-- Visual markers have no collision geometry and do not alter robot motion. -->
    <model name="start_marker"><static>true</static><pose>0 0 0.001 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.65</radius><length>0.001</length></cylinder></geometry><material><ambient>0.33 0.62 0.48 1</ambient><diffuse>0.33 0.62 0.48 1</diffuse></material></visual></link></model>
  </world>
</sdf>
